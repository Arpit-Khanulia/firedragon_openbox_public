@import "~/.config/rofi/colors/wallust.rasi"

configuration {
    show-icons: true;
}

window {
    transparency: "real";
    background-color: @background;
    text-color: @foreground;
    border: 2px solid;
    border-color: @border;
    border-radius: 12px;
    width: 80%;
    height: 70%;
    location: center;
    anchor: center;
}

mainbox {
    enabled: true;
    children: [ inputbar, listview ];
    background-color: transparent;
    spacing: 15px;
    padding: 20px;
}

inputbar {
    enabled: true;
    background-color: @background-alt;
    text-color: @foreground;
    border-radius: 8px;
    padding: 12px 16px;
    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @selected;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled: true;
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search Wallpapers...";
    placeholder-color: @background;
    font: "JetBrainsMono Nerd Font 11";
}

listview {
    enabled: true;
    columns: 4;
    lines: 3;
    spacing: 15px;
    background-color: transparent;
    layout: vertical;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    enabled: true;
    orientation: vertical;
    padding: 10px;
    border-radius: 8px;
    background-color: @background-alt;
    text-color: @foreground;
}

element selected {
    background-color: @selected;
    text-color: @background;
    border: 2px solid;
    border-color: @active;
}

element-icon {
    size: 160px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 10";
}
